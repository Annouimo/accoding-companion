{
  "name": "@annouimo/accoding-companion",
  "version": "0.2.0-next.0",
  "description": "Non-official Accoding companion for C/C++ coursework",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "accoding": "./dist/accoding.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/accoding.cjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "install.sh",
    "install.ps1"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/standalone/*.test.ts tests/standalone/*.test.mjs",
    "pack:dry": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "markdown-it": "14.3.2",
    "sanitize-html": "2.17.7",
    "tough-cookie": "5.1.2",
    "zod": "3.25.76",
    "katex": "0.16.22",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/markdown-it": "14.2.0",
    "@types/sanitize-html": "2.16.1",
    "@types/katex": "0.16.8",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "@types/turndown": "5.0.6"
  }
}
